# ─────────────────────────────────────────────────────────────────────────────
# PRAHARI settings. Copy this file to `prahari.env` and fill in the first line.
#   (Mac/Linux:  cp prahari.env.example prahari.env
#    Windows:    copy prahari.env.example prahari.env)
# ─────────────────────────────────────────────────────────────────────────────

# 1. REQUIRED — the camera list.
#    The Sentinel grid's list is https://cctv.corp8.cloud/cameras.json, but it needs a
#    logged-in session. Easiest: open that link in the browser where you are logged in
#    to the Sentinel portal, save the page as  sentinel-cameras.json  in this folder,
#    and keep the line below. If the camera list changes, save it again.
INGEST_URL=sentinel-cameras.json

# 2. REQUIRED for the Sentinel grid — the stream login.
#    The team's REGISTERED EMAIL and ACCESS PASSWORD (the email must be on the approved
#    access list). Write the email normally, e.g. you@example.com — PRAHARI encodes the
#    "@" itself. The password stays in this file only: never commit or share prahari.env.
STREAM_USER=
STREAM_PASSWORD=

# 3. Used only for cameras whose catalogue entry has no stream URL: {id} = camera id.
#    This is the RTSP endpoint documented in the Sentinel Integrator's Guide.
RTSP_TEMPLATE=rtsp://103.250.160.189:8554/stream/{id}

# 4. Optional. Your browser's session cookie for cctv.corp8.cloud, to read cameras.json
#    live instead of from a saved file (and to use the HLS fallback). Leave empty if unsure.
INGEST_COOKIE=
INGEST_TOKEN=

# ── Everything below is optional. The defaults are sensible. ────────────────

# Where the web console is served. Open http://HOST:PORT in a browser.
# Use HOST=0.0.0.0 to let other computers on your network open it.
HOST=127.0.0.1
PORT=8000

# How many cameras to process (0 = all of them). Lower this on a slow laptop.
MAX_CAMERAS=0

# full      = decode every frame, read plates TARGET_FPS times a second per camera (best results)
# keyframes = decode only keyframes, ~1 frame every 1-2 s (very light; misses fast cars)
CAPTURE_MODE=full
TARGET_FPS=2

# Frame width used for plate reading. 1280 reads plates much better than 640.
MAX_WIDTH=1280

# Plate reading on/off, and whether to keep small evidence snapshots (capped at 300 MB).
ANPR=1
SAVE_EVIDENCE=1

# best  = one alert per vehicle pass, using its best read (arrives ~6 s after the car passes)
# first = alert on the very first read (instant, but that read may be worse)
DEDUP_MODE=best

# Load a clearly-labelled SAMPLE watchlist on first start if the watchlist is empty.
SEED_SAMPLE_WATCHLIST=1

# Database file (default: data/prahari.db)
DB=
